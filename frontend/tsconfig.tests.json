{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "chai": ["./node_modules/@types/chai/index.d.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "*": ["./node_modules/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "types": [
      "@testing-library/jest-dom",
      "react",
      "react-dom",
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src/vite-env.d.ts",
    "../tests/epic1/frontend",
    "../tests/shared/frontend"
  ]
}
