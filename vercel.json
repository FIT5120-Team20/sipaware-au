{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/iteration3/:path*",
          "destination": "/:path*"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 120
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "https://sipaware-au-iteration2.vercel.app/iteration2"
    },
    {
      "source": "/iteration3/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/iteration3",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/iteration3/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/iteration2",
      "destination": "https://sipaware-au-iteration2.vercel.app/iteration2"
    },
    {
      "source": "/iteration2/:path*",
      "destination": "https://sipaware-au-iteration2.vercel.app/iteration2/:path*"
    },
    {
      "source": "/iteration:iteration(\\d+)/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/:path*",
      "destination": "https://sipaware-au-iteration2.vercel.app/iteration2/:path*"
    }
  ],
  "proxy": {
    "entrypoint": "middleware.js",
    "matcher": "/:path*"
  }
}
