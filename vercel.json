{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/iteration2/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/iteration2",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/iteration2/:path*",
      "destination": {
        "service": "frontend",
        "path": "/:path*"
      }
    },
    {
      "source": "/:path*",
      "destination": "https://sipaware-kjhwp8xl6-claway.vercel.app/:path*"
    }
  ]
}
